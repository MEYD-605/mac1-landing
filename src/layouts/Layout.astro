---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "mac1 — Sovereign Orchestrator of maclab" } = Astro.props;
---

<!DOCTYPE html>
<html lang="th" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts: Alumni Sans Pinstripe, Alumni Sans, Albert Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Albert+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Alumni+Sans+Pinstripe:ital@0;1&family=Alumni+Sans:ital,wght@0,100..900;1,100..900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Theme Initialization: Prevents page flash -->
    <script is:inline>
      (function() {
        const storedTheme = typeof localStorage !== 'undefined' && localStorage.getItem('theme');
        const systemPrefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        const theme = storedTheme || (systemPrefersLight ? 'light' : 'dark');
        const html = document.documentElement;
        if (theme === 'light') {
          html.classList.remove('dark');
          html.classList.add('light');
        } else {
          html.classList.remove('light');
          html.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-[var(--color-lacquer-black)] text-[var(--color-text-warm)] font-sans antialiased min-h-screen selection:bg-[var(--color-kinpaku-gold)] selection:text-[var(--color-lacquer-deep)]">
    <div class="max-w-6xl mx-auto px-4 py-8 md:py-12">
      <slot />
    </div>

    <!-- Floating Theme Toggle Button -->
    <button id="theme-toggle" class="fixed bottom-6 right-6 z-50 bg-[var(--color-raised-lacquer)] hover:bg-[var(--color-lacquer-deep)] border border-[var(--color-gold-hairline-strong)] text-[var(--color-kinpaku-gold)] hover:text-[var(--color-champagne)] rounded-full p-3 shadow-lg cursor-pointer transition-all duration-200" aria-label="Toggle theme">
      <!-- Sun Icon (shows when dark mode is active) -->
      <svg id="theme-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M22 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      <!-- Moon Icon (shows when light mode is active) -->
      <svg id="theme-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>

    <!-- Theme Toggle Handler -->
    <script is:inline>
      (function() {
        const updateIcons = (currentTheme) => {
          const sunIcon = document.getElementById('theme-sun');
          const moonIcon = document.getElementById('theme-moon');
          if (!sunIcon || !moonIcon) return;
          if (currentTheme === 'light') {
            sunIcon.classList.add('hidden');
            moonIcon.classList.remove('hidden');
          } else {
            sunIcon.classList.remove('hidden');
            moonIcon.classList.add('hidden');
          }
        };

        const setupToggle = () => {
          const html = document.documentElement;
          const currentTheme = html.classList.contains('light') ? 'light' : 'dark';
          updateIcons(currentTheme);

          const toggleBtn = document.getElementById('theme-toggle');
          if (toggleBtn) {
            toggleBtn.addEventListener('click', () => {
              const isLight = html.classList.contains('light');
              if (isLight) {
                html.classList.remove('light');
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                updateIcons('dark');
              } else {
                html.classList.remove('dark');
                html.classList.add('light');
                localStorage.setItem('theme', 'light');
                updateIcons('light');
              }
            });
          }
        };

        // Run on load and after Astro transitions if active
        window.addEventListener('DOMContentLoaded', setupToggle);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Albert Sans', 'Avenir Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-display: 'Alumni Sans Pinstripe', 'Alumni Sans', sans-serif;
    --font-mono: 'JetBrains Mono', SFMono-Regular, Consolas, monospace;
  }
  
  body {
    font-family: var(--font-sans);
  }
  
  code, pre, .font-mono {
    font-family: var(--font-mono);
  }

  .font-display {
    font-family: var(--font-display);
  }
</style>
